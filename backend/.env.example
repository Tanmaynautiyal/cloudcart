# ==============================================================================
# CloudCart Backend Environment Variables Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust the variables for your local or production environment:
#   cp .env.example .env
# ==============================================================================

# --- Application Settings ---
PROJECT_NAME="CloudCart API"
API_V1_STR="/api/v1"

# --- Security & JWT Authentication ---
# Generate a cryptographically secure random key using: openssl rand -hex 32
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7  # 24 hours (1 day)

# --- PostgreSQL Database Connection ---
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/cloudcart_db"

# Optional: SQLite local development fallback if PostgreSQL is not active
# DATABASE_URL="sqlite:///./cloudcart.db"

# --- CORS (Cross-Origin Resource Sharing) ---
# Allowed frontend origins (JSON list or comma-separated URLs)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
