# -------------------------------------------------------------
# ENVIRONMENT SWITCH
# false = use local backend | true = use production server
# -------------------------------------------------------------
VITE_IS_PRODUCTION=false

# -------------------------------------------------------------
# BACKEND API ENDPOINTS
# -------------------------------------------------------------
# Local backend server
VITE_API_BASE_URL_LOCAL=http://localhost:8001/api/v1

# Remote / Production backend server
VITE_API_BASE_URL_SERVER=http://localhost:8001/api/v1

# General API base URL fallback
VITE_API_BASE_URL=http://localhost:8001/api/v1

# -------------------------------------------------------------
# APPLICATION SETTINGS
# -------------------------------------------------------------
VITE_APP_NAME=CloudCart
VITE_MAINTENANCE_MODE=false
VITE_HIDE_CONSOLE=false
